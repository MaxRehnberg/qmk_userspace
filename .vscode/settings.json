{
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed",
        "--function-arg-placeholders",
        "--header-insertion=iwyu"
    ],
    "clangd.path": "clangd",
    "files.associations": {
        "*.h": "c",
        "*.c": "c"
    },
    "C_Cpp.intelliSenseEngine": "disabled",
    "editor.formatOnSave": true,
    "clang-format.executable": "clang-format"
}
